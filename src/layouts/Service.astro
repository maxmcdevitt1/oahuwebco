---
// One service page, laid out as the old site was: hero with the headline, then a light sheet holding the
// hook sentence (beside the page's graphic when it has one), the problems as a numbered list, an optional
// "What changes" check list, anything the page adds after that (the report on Measure and improve), the
// questions, and links to the other pages; the footer carries the closing line.
// Schema: Service, WebPage, BreadcrumbList and FAQPage.
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Divider from "../components/Divider.astro";
import Section from "../components/Section.astro";
import Faq from "../components/Faq.astro";
import ServiceRows from "../components/ServiceRows.astro";
import Footer from "../components/Footer.astro";
import { site, services, businessId, type ServiceSlug } from "../lib/site";

type Pair = readonly [string, string];
interface Props {
  slug: ServiceSlug;
  /** <title> */
  title: string;
  description: string;
  /** schema.org Service name */
  serviceName: string;
  h1: string;
  hook: string;
  /** hero and closing-line button; the href is a home-page form anchor */
  button: string;
  buttonHref: string;
  problemsTitle: string;
  problems: readonly Pair[];
  changes?: readonly Pair[];
  faq: readonly Pair[];
  more: readonly ServiceSlug[];
  ctaTitle: string;
}
const { slug, title, description, serviceName, h1, hook, button, buttonHref, problemsTitle, problems, changes, faq, more, ctaTitle } = Astro.props;
const hasMedia = Astro.slots.has("default");
const url = `${site.url}/${slug}/`;
const name = services.find((s) => s.slug === slug)!.name;
const schema = [
  { "@type": "Service", "@id": `${url}#service`, name: serviceName, serviceType: serviceName, description, url, provider: { "@id": businessId }, areaServed: { "@type": "Place", name: "Oʻahu, Hawaii" } },
  { "@type": "WebPage", "@id": `${url}#webpage`, url, name: title, description, isPartOf: { "@id": `${site.url}/#website` }, about: { "@id": `${url}#service` }, breadcrumb: { "@id": `${url}#breadcrumb` } },
  { "@type": "BreadcrumbList", "@id": `${url}#breadcrumb`, itemListElement: [
    { "@type": "ListItem", position: 1, name: site.name, item: `${site.url}/` },
    { "@type": "ListItem", position: 2, name, item: url },
  ] },
  { "@type": "FAQPage", "@id": `${url}#faq`, mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
];
---
<Base title={title} description={description} schema={schema}>
  <Header />
  <Hero eyebrow="What we do" title={h1}>
    <a class="btn btn-accent" href={buttonHref}>{button}</a>
  </Hero>
  <main class="sheet">
    <div class="container">
      <Divider />
      <section class:list={["hookrow", { media: hasMedia }]}>
        <p class="hooktext">{hook}</p>
        {hasMedia && <div class="media"><slot /></div>}
      </section>
      <Divider />
      <section class="block" id="problems" aria-labelledby="problems-heading">
        <h2 class="h2" id="problems-heading">{problemsTitle}</h2>
        <ol class="leak-list">
          {problems.map(([t, p]) => <li class="reveal"><h3 class="h3" set:html={t} /><p class="muted">{p}</p></li>)}
        </ol>
      </section>
      {changes && (
        <>
          <Divider />
          <section class="changes" aria-labelledby="changes-heading">
            <h2 class="h2" id="changes-heading">What changes</h2>
            <ul class="checks">
              {changes.map(([t, p]) => <li class="reveal"><h3 class="h3">{t}</h3><p class="muted">{p}</p></li>)}
            </ul>
          </section>
        </>
      )}
      {Astro.slots.has("after") && (
        <>
          <Divider />
          <slot name="after" />
        </>
      )}
      <Divider />
      <Section title="Questions"><Faq items={faq} /></Section>
      <Divider />
      <Section title="More of what we do"><ServiceRows slugs={more} /></Section>
    </div>
  </main>
  <Footer title={ctaTitle} button={button} href={buttonHref} />
</Base>
