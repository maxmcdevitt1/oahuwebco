---
// Full-screen navy page used by 404 and the post-submit thank-you page.
import Base from "../layouts/Base.astro";
import Island from "./Island.astro";
import Brand from "./Brand.astro";
import { site } from "../lib/site";
interface Props { title: string; heading: string }
const { title, heading } = Astro.props;
---
<Base title={title} noindex bodyClass="notice">
  <Island />
  <header class="wrap"><Brand /></header>
  <main class="wrap">
    <h1 class="narrow">{heading}</h1>
    <slot />
    <a class="btn" href="/">Back to the home page</a>
  </main>
  <footer class="wrap">
    <strong>{site.name}</strong> {site.tagline} {site.town}, {site.island}.
  </footer>
</Base>
