---
// Links to other service pages, one per row with an arrow.
import { services, type ServiceSlug } from "../lib/site";
interface Props { slugs: readonly ServiceSlug[] }
const { slugs } = Astro.props;
const byslug = Object.fromEntries(services.map((s) => [s.slug, s.name]));
---
<ul class="rows">
  {slugs.map((s) => <li><a href={`/${s}/`}>{byslug[s]}<span class="arrow" aria-hidden="true">→</span></a></li>)}
</ul>
