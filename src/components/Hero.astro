---
// Full-height navy hero. The gradient backdrop and the island sit on their own layer so the hero can
// drift down (and the backdrop up) as the first sheet scrolls over it. `home` fills the viewport;
// `inner` is shorter for service and company pages; `center` centres a single ask.
import Island from "./Island.astro";
interface Props {
  variant?: "home" | "inner" | "center";
  eyebrow?: string;
  title: string;
  /** Instrument Serif size class for the h1 */
  size?: "display-xl" | "display-l" | "display-m";
  /** the one-sentence hook under the headline */
  hook?: string;
  id?: string;
}
const { variant = "inner", eyebrow, title, size = variant === "home" ? "display-xl" : "display-l", hook, id } = Astro.props;
---
<section class:list={["hero", variant]} id={id}>
  <div class="bg" aria-hidden="true">
    <div class="glow"></div>
    <Island />
  </div>
  <div class="container">
    <div class="copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class={size}>{title}</h1>
      {hook && <p class="hook">{hook}</p>}
      {Astro.slots.has("default") && <div class="actions"><slot /></div>}
    </div>
  </div>
</section>
