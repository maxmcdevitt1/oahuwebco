---
// The auto-scrolling row of white cards (newfront's logo carousel, with our pages in it). The list is
// rendered twice so the CSS loop is seamless; the copy is marked hidden from assistive tech.
import { services } from "../lib/site";
const text: Record<string, string> = {
  "convert-more-inquiries": "Call handling, fast replies and estimate follow-up that turn interest into booked jobs.",
  "build-repeat-business": "Reviews, service reminders and referrals that bring customers back and send new ones your way.",
  "measure-and-improve": "Analytics, tracking and automation that show what’s working and where to invest next.",
  "local-seo": "If you’re not on the map, you’re not on the list.",
  "websites": "A website that doesn’t get calls is just a brochure.",
};
const Arrow = `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
---
<div class="ticker">
  <ul class="track">
    {[0, 1].map((copy) => services.map((s) => (
      <li class="tcard" aria-hidden={copy === 1 ? "true" : undefined}>
        <h3 class="h3"><a href={`/${s.slug}/`} tabindex={copy === 1 ? -1 : undefined}>{s.name}</a></h3>
        {s.slug === "reach-more-customers"
          ? <p><a href="/local-seo/" tabindex={copy === 1 ? -1 : undefined}>Local search</a>, Google Business Profiles, <a href="/websites/" tabindex={copy === 1 ? -1 : undefined}>websites</a> and ads that put you in front of the people looking for your work.</p>
          : <p>{text[s.slug]}</p>}
        <span class="go" set:html={Arrow} />
      </li>
    )))}
  </ul>
</div>
