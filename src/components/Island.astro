---
// The Oʻahu silhouette that sits behind every hero. Decorative only; sized and tinted by the page CSS.
import { islandPath, islandViewBox } from "../lib/island";
interface Props { class?: string }
const { class: className = "island" } = Astro.props;
---
<svg class={className} viewBox={islandViewBox} aria-hidden="true" focusable="false"><path d={islandPath}/></svg>
