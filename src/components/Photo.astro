---
// A photo band between two sheets, as on newfront.com: the picture is fixed to the viewport behind the
// page, the band is a window cut through to it (clip-path), and the next sheet slides up over it.
// Photos live in src/assets/photos (credits in CREDITS.md there); Astro resizes them to WebP at build.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  src: ImageMetadata;
  alt: string;
  /** shorter window, for inner pages */
  short?: boolean;
}
const { src, alt, short } = Astro.props;
---
<section class:list={["pband", { short }]} aria-label={alt}>
  <div class="fixed">
    <Image src={src} alt="" widths={[800, 1280, 1920, 2400]} sizes="100vw" format="webp" quality={82} loading="lazy" />
  </div>
</section>
