---
// A full-width photo the reader scrolls past between sections: rounded frame, the picture a little
// taller than the frame and drifting against the scroll (motion.ts moves anything with data-parallax).
// Photos live in src/assets/photos (credits in CREDITS.md there); Astro resizes them at build time.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  src: ImageMetadata;
  alt: string;
  /** shorter band, for inner pages */
  short?: boolean;
}
const { src, alt, short } = Astro.props;
---
<figure class:list={["photo", { short }]}>
  <div class="frame">
    <Image src={src} alt={alt} widths={[640, 1000, 1600, 2400]} sizes="(max-width: 1023px) 100vw, min(100vw, 1600px)" format="webp" quality={76} loading="lazy" data-parallax="70" />
  </div>
</figure>
