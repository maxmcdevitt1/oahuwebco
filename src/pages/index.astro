---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Divider from "../components/Divider.astro";
import Ticker from "../components/Ticker.astro";
import Island from "../components/Island.astro";
import Footer from "../components/Footer.astro";
import ContactForm, { formSubmitOrigin } from "../components/ContactForm.astro";
import { site, services, businessSchema } from "../lib/site";

const title = `${site.name} · ${site.tagline}`;
const offers = services.map((s) => ({
  "@type": "Offer",
  itemOffered: { "@id": `${site.url}/${s.slug}/#service`, "@type": "Service", name: s.name, url: `${site.url}/${s.slug}/` },
}));
const schema = [
  {
    ...businessSchema,
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Services",
      itemListElement: [
        ...offers,
        { "@type": "Offer", name: "30-day missed-call trial", price: "0", priceCurrency: "USD", url: `${site.url}/convert-more-inquiries/`, itemOffered: { "@id": `${site.url}/convert-more-inquiries/#service` } },
      ],
    },
  },
  { "@type": "WebSite", "@id": `${site.url}/#website`, url: `${site.url}/`, name: site.name, alternateName: "Oahu Webco", publisher: { "@id": businessSchema["@id"] } },
];

const Chevron = (dir: "prev" | "next") =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${dir === "prev" ? "M15 5l-7 7 7 7" : "M9 5l7 7-7 7"}"/></svg>`;
---
<Base title={title} schema={schema} formAction={[formSubmitOrigin]}>

<Header />

<Hero variant="home" id="top" title="We take the online side off your hands.">
  <a class="btn btn-accent" href="#free-trial">Try it free for 30 days</a>
</Hero>

<main class="sheet" id="what">
  <div class="container">
    <Divider />
    <div class="bhead">
      <h2 class="h2" id="what-heading">What we do</h2>
      <p class="lead">We help local businesses improve their online performance: more of the right customers finding you, more calls, more jobs.</p>
    </div>
  </div>
  <Ticker />
</main>

<section class="band" id="pricing" aria-labelledby="pricing-heading">
  <div class="fixed" aria-hidden="true"><Island /></div>
  <div class="container">
    <div class="bhead">
      <h2 class="h2" id="pricing-heading">Pricing</h2>
      <div class="tools">
        <button class="round" type="button" data-scroll="prices" data-dir="prev" aria-label="Previous" set:html={Chevron("prev")} />
        <button class="round" type="button" data-scroll="prices" data-dir="next" aria-label="Next" set:html={Chevron("next")} />
      </div>
    </div>
    <ul class="scroller" id="prices">
      <li class="pcard"><span class="pill">30-day missed-call trial</span><p>We catch the calls you can’t pick up and show you how many turned into jobs. Free for 30 days, then month to month from $300 a month, estimated. If your average job is $400, one caught call a month covers it. It stops on its own if you don’t continue.</p><p class="amt">$0</p></li>
      <li class="pcard"><span class="pill">Free review</span><p>Where your business stands online, and where the room to grow is.</p><p class="amt">$0</p></li>
      <li class="pcard"><span class="pill">Foundation</span><p>One-time. Close the gaps holding you back and set up what growth is built on. Done in ten business days, and you pay when it’s done. Estimated range; your exact price is quoted after the review.</p><p class="amt">$750–$1,500<small>est.</small></p></li>
      <li class="pcard"><span class="pill">Ongoing growth</span><p>Steady monthly work on what grows your business. Month to month; you keep everything if you stop. Estimated range; your exact price is quoted after the review.</p><p class="amt">$300–$750<small>/mo est.</small></p></li>
      <li class="pcard"><span class="pill">Websites</span><p><a href="/websites/">Built to bring in work.</a> Estimated price; your exact price is quoted after the review.</p><p class="amt">$500<small>est.</small></p></li>
    </ul>
  </div>
</section>

<section class="sheet" id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <div class="contact">
      <div class="copy">
        <p class="eyebrow">Start free</p>
        <h2 class="big" id="contact-heading">Aloha. Tell us about your business and we’ll get back to you.</h2>
        <p class="muted">Or call, text or email directly:</p>
        <p class="big"><a href={site.phone.href}>{site.phone.display}</a></p>
        <p class="big"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <ContactForm />
    </div>
  </div>
</section>

<Footer />

</Base>
