---
import Service from "../layouts/Service.astro";
import tool_belt from "../assets/photos/tool-belt.jpg";
import Section from "../components/Section.astro";
// Example report with made-up numbers, as on the old page
const months: [string, number][] = [["Apr", 19], ["May", 22], ["Jun", 21], ["Jul", 27], ["Aug", 30], ["Sep", 34]];
const sources: [string, number][] = [["Google listing", 7], ["Referrals", 4], ["Website", 3], ["Repeat customers", 2], ["Google ads", 1]];
// line chart geometry (520×220 box, 0–40 scale)
const x = (i: number) => 36 + i * 92;
const y = (v: number) => 186 - (v / 40) * 166;
const path = months.map(([, v], i) => `${i ? "L" : "M"}${x(i)} ${y(v).toFixed(1)}`).join(" ");
---
<Service
  slug="measure-and-improve"
  title="Marketing Analytics and Call Tracking on Oʻahu · Oahu Web Co."
  description="Analytics, call and form tracking, automation and a plain monthly report for Oʻahu businesses. See which work brings in jobs. Based in Kāneʻohe."
  serviceName="Marketing analytics, call and form tracking, automation and reporting"
  h1="Measure and improve"
  hook="Stop guessing which marketing brings in your jobs."
  button="Request my free review"
  buttonHref="/#free-review"
  problemsTitle="The work"
  problems={[
    ["Know where jobs come from", "You’ll know which listing, ad or referral brought in each call, form and message."],
    ["Monthly report", "One page each month in plain words: how many inquiries and jobs came in, where they came from, and what comes next."],
    ["Nothing forgotten", "The tasks that keep slipping through the cracks happen on time, without anyone having to remember."],
    ["Your accounts, your data", "Your numbers live in your own accounts, so they stay yours."],
  ]}
  faq={[
    ["What will I actually see?", "A one-page report each month and a short call to go over it if you want one. No dashboards you have to learn."],
    ["Do you need access to my finances?", "No. Job counts and, if you’re willing to share it, your average job value are enough to show which channels pay."],
  ]}
  more={["reach-more-customers", "convert-more-inquiries", "build-repeat-business"]}
  ctaTitle="Get a free review"
  photo={tool_belt}
  photoAlt="A tool belt with a tape measure and screwdrivers, on a job site"
>
  <Section title="What a monthly report looks like" slot="after">
    <article class="report" aria-label="Example monthly report with made-up numbers">
      <header class="rg-head">
        <div><p class="rg-kicker">Monthly report · September</p><h3>Example Roofing Co.</h3></div>
      </header>
      <ul class="rg-tiles">
        <li><span class="rg-big">34</span><span class="rg-lbl">Inquiries</span><span class="rg-chg">Up 4 from August</span></li>
        <li><span class="rg-big">17</span><span class="rg-lbl">Booked jobs</span><span class="rg-chg">Up 3 from August</span></li>
        <li><span class="rg-big">12 min</span><span class="rg-lbl">Typical reply time</span><span class="rg-chg">Was about 3 hours</span></li>
      </ul>
      <div class="rg-charts">
        <figure>
          <figcaption>Booked jobs by source</figcaption>
          <ul class="rg-bars">
            {sources.map(([s, n]) => <li><span class="rg-name">{s}</span><span class="rg-track"><span class="rg-bar" style={`width:${Math.round((n / 7) * 100)}%`}></span></span><span class="rg-num">{n}</span></li>)}
          </ul>
        </figure>
        <figure>
          <figcaption>Inquiries per month</figcaption>
          <svg class="rg-line" viewBox="0 0 520 220" role="img" aria-label="Example: inquiries per month rose from 19 in April to 34 in September">
            {[0, 10, 20, 30, 40].map((t) => <><line x1="36" x2="496" y1={y(t)} y2={y(t)} class="rg-grid"/><text x="28" y={y(t) + 4} class="rg-tick" text-anchor="end">{t}</text></>)}
            {months.map(([m], i) => <text x={x(i)} y="210" class="rg-tick" text-anchor="middle">{m}</text>)}
            <path d={path} class="rg-path"/>
            {months.map(([m, v], i) => <circle cx={x(i)} cy={y(v)} r="4.5" class="rg-dot"><title>{m}: {v} inquiries</title></circle>)}
            <text x={x(5) - 10} y={y(34) - 12} class="rg-val" text-anchor="end">34</text>
            <text x={x(0) + 10} y={y(19) - 12} class="rg-val">19</text>
          </svg>
        </figure>
      </div>
    </article>
  </Section>
</Service>
