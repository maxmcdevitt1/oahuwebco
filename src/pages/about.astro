---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import ServiceRows from "../components/ServiceRows.astro";
import Footer from "../components/Footer.astro";
import { site, businessId } from "../lib/site";

const title = `Who’s Behind ${site.name} · ${site.town}, ${site.island}`;
const description = "My name is Max, and I am the creator of Oahu Web Co. I am a veteran of the United States Army.";
const url = `${site.url}/about/`;
const schema = [
  { "@type": "AboutPage", "@id": `${url}#page`, name: "Who’s behind Oahu Web Co.", url, about: { "@id": businessId }, mainEntity: { "@id": `${url}#founder` } },
  { "@type": "Person", "@id": `${url}#founder`, name: "Max", jobTitle: "Founder", worksFor: { "@id": businessId }, homeLocation: { "@type": "Place", name: "Kāneʻohe, Oʻahu, Hawaii" } },
  { "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: site.name, item: `${site.url}/` },
    { "@type": "ListItem", position: 2, name: "Who’s behind it", item: url },
  ] },
];
---
<Base title={title} description={description} schema={schema}>
  <Header />
  <Hero eyebrow="About" title="Who’s behind the scenes?" />
  <main class="sheet">
    <div class="container">
      <section class="about" aria-label="About Max">
        <figure class="portrait">
          <img src="/about/max-photo.jpg" width="849" height="1853" alt="Max in a navy suit and red tie, walking and smiling" loading="eager">
        </figure>
        <div class="prose">
          <p>My name is Max, and I am the creator of Oahu Web Co. I am a veteran of the United States Army, and I created this company because I’ve seen the small businesses on the island, and I’ve seen the same problem again and again: companies have a great business and do great work, but the money comes in slow.</p>
          <p>The truth is, to be able to succeed as a small business in today’s world, you need to be <em class="serif-i">convenient</em>. People don’t want to go through two Google pages and have to rely on a business that has no information and two reviews. And you don’t want to be the company stuck on the third page while all the companies on the first are getting jobs.</p>
          <p>That’s why I created Oahu Web Co.: to serve the small businesses of Oʻahu and assist them with their online presence, from searchability, to professional web pages, or to something else. I am here to assist you and your business in today’s digital world, and together we will convert your company into a top performer!</p>
        </div>
      </section>
      <Section title="What we do">
        <ServiceRows slugs={["reach-more-customers", "convert-more-inquiries", "build-repeat-business", "measure-and-improve"]} />
      </Section>
    </div>
  </main>
  <Footer title="Get a free review" text="Tell us about your business and we’ll show you where the room to grow is." button="Request my free review" href="/#free-review" />
</Base>
